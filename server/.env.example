DATABASE_URL="postgresql://localhost:5432/expense_platform_dev?schema=public"
PORT=4000
JWT_SECRET="請用 openssl rand -hex 32 產生一組隨機值，不要沿用範例"

# Email 通知(選填)：申請單送出/簽核/駁回/退回時寄信提醒相關人員。
# 不設定的話 email 通知會靜默略過，站內通知(鈴鐺清單)不受影響、照常運作。
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_USER="your-account@gmail.com"
# SMTP_PASS="應用程式密碼，不是登入密碼(大部分服務商都是如此，例如 Gmail 要另外去帳號設定產生)"
# SMTP_FROM="expense-platform@your-domain.com"
