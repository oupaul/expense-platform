generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── 平台管理者(服務供應商) ─────────────────────────────
// 跟租戶內部的 User 是完全分開的兩套帳號體系：User 一定屬於某個 Company(companyId 必填)，
// 這裡的帳號不屬於任何租戶，是平台方用來建立/管理租戶本身的身分，故意不共用同一張表，
// 避免「租戶管理員」跟「平台管理員」的權限邊界混在一起搞錯。
model PlatformAdmin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
}

// 平台層級的備份排程設定——整個平台共用一筆(不是每租戶各一份)，因為備份的是共用的
// 資料庫跟 uploads/，不是單一租戶的資料。用固定 id "singleton" 確保永遠只有一筆。
model BackupConfig {
  id             String  @id @default("singleton")
  enabled        Boolean @default(false)
  cronExpression String  @default("0 3 * * *")
  retentionDays  Int     @default(14)

  // NAS 遠端備份(選填)：用 SSH + rsync 鏡像同步本機備份目錄。
  nasEnabled    Boolean @default(false)
  nasHost       String?
  nasPort       Int     @default(22)
  nasUsername   String?
  nasRemotePath String?
  // SSH 私鑰用跟 JWT_SECRET 同源衍生的金鑰加密後才存進來(AES-256-GCM)，
  // API 絕對不會把解密後的內容回傳給前端。
  nasPrivateKeyEnc String? @db.Text

  lastRunAt      DateTime?
  lastRunStatus  String? // "success" / "failed"
  lastRunMessage String?   @db.Text

  updatedAt DateTime @updatedAt
}

// 平台層級的 email 通知設定——整個平台共用一組 SMTP 帳號寄信(不是每租戶各自設定一組)，
// 跟上面 BackupConfig 的 NAS 設定同一種模式：固定 id "singleton"，用同一支
// encryptSecret/decryptSecret(跟 JWT_SECRET 同源衍生金鑰)存密碼，API 絕對不會把
// 明碼密碼回傳給前端，只回「有沒有設定」。
model NotificationConfig {
  id          String  @id @default("singleton")
  smtpEnabled Boolean @default(false)
  smtpHost    String?
  smtpPort    Int     @default(587)
  smtpSecure  Boolean @default(false)
  smtpUser    String?
  smtpPassEnc String? @db.Text
  smtpFrom    String?

  updatedAt DateTime @updatedAt
}

// ── 租戶(公司) ─────────────────────────────────────
// 品牌識別 + 表單結構開關都放在這裡，因為這些是「一家公司改一次、很少變動」的設定，
// 不需要像部門/費用類別那樣做成獨立的可增刪列表。
model Company {
  id        String   @id @default(cuid())
  slug      String   @unique // 網址/API 用的公司代號，例如 "demo-a"、"demo-b"
  name      String
  nameEn    String?
  logoUrl   String?

  // 平台管理者停用租戶用——合約到期/欠費時整家公司都不能登入，但資料保留。
  // 只在登入當下檢查，已經登入、token 還沒過期(8 小時)的使用者不會被立刻踢掉。
  active Boolean @default(true)

  // 品牌配色 —— 對應前端 CSS variable，預設值沿用參考版型的深色 header + 藍紫漸層配色
  primaryColor   String @default("#3498db")
  headerBgColor  String @default("#2c3e50")
  gradientFrom   String @default("#667eea")
  gradientTo     String @default("#764ba2")

  // 表單結構開關
  multiCurrencyEnabled Boolean @default(false)
  optionalFields       Json    @default("{\"projectCode\":false,\"invoiceDate\":false,\"payeeInfo\":false,\"requestedPaymentDate\":false}")

  // 列印/PDF 每頁最多幾筆費用明細，超過就分頁。純粹是版面偏好，跟 optionalFields 不同，
  // 不需要照每張申請單當初送出時的設定「凍結」——改了之後舊申請單一樣套用新數字重印。
  // 實測(見 PrintableApplicationForm.tsx)：說明欄位短文字不換行時，一頁 A4 大約能放到
  // 16 筆左右就會超出可印刷高度，超過這個數字風險是被 usePrintFit 縮到字很小。
  printRowsPerPage Int @default(12)

  departments       Department[]
  expenseCategories ExpenseCategory[]
  expenseNatures    ExpenseNature[]
  approvalStages    ApprovalStage[]
  exchangeRates     ExchangeRate[]
  users             User[]
  applications      ExpenseApplication[]
  notifications     Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── 後台可維護的選項資料(部門/費用類別/費用性質) ──────────
// 三者結構相同(名稱 + 排序 + 啟用狀態)，各自建表方便日後各自加專屬欄位(例如費用類別要加預算上限)。

model Department {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  sortOrder Int     @default(0)
  active    Boolean @default(true)

  users        User[]
  applications ExpenseApplication[]

  @@unique([companyId, name])
  @@index([companyId, active])
}

model ExpenseCategory {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  sortOrder Int     @default(0)
  active    Boolean @default(true)
  // 選到這個類別時，費用明細列的專案編號要變必填(且最多 10 碼)，例如「專案相關」。
  requiresProjectCode Boolean @default(false)

  items ExpenseItem[]

  @@unique([companyId, name])
  @@index([companyId, active])
}

model ExpenseNature {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  sortOrder Int     @default(0)
  active    Boolean @default(true)

  applications ExpenseApplication[]

  @@unique([companyId, name])
  @@index([companyId, active])
}

// ── 簽核關卡設定 ──────────────────────────────────
// 用陣列式的表(而非寫死 4 關)，後台可增刪關卡、改標籤、調順序。
model ApprovalStage {
  id         String  @id @default(cuid())
  companyId  String
  company    Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  stageOrder Int // 0-based，決定簽核順序
  roleKey    String // 對應 User.role，例如 dept_manager / finance / ceo
  label      String // 顯示用職稱，例如「執行長核准」
  // 軟刪除：已經有申請單簽核紀錄參照這個關卡時，直接硬刪除會撞到外鍵，
  // 跟 Department/ExpenseCategory/ExpenseNature 用同一套模式。
  active     Boolean @default(true)

  records ApprovalRecord[]

  @@unique([companyId, stageOrder])
  @@index([companyId])
}

// ── 匯率設定(後台維護，供多幣別換算用) ──────────────
// 只存「非台幣」幣別對台幣的匯率，TWD 本身固定視為 1，不用存。
model ExchangeRate {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  currency    String // USD / JPY / CNY / EUR
  rateToTWD   Decimal  @db.Decimal(12, 6)
  updatedAt   DateTime @updatedAt

  @@unique([companyId, currency])
}

// ── 使用者 ────────────────────────────────────────
model User {
  id           String      @id @default(cuid())
  companyId    String
  company      Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  email        String
  passwordHash String
  name         String
  role         String // applicant / dept_manager / finance / ceo / admin
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  active       Boolean     @default(true)
  // 跟 role 分開的獨立權限旗標：role 同時也是簽核關卡比對用的 roleKey，
  // 不能直接拿「查閱者」當一種 role，否則可能被某個簽核關卡的 roleKey 意外比對到，
  // 變成憑空多了簽核權限。開了這個旗標的人可以看報表跟全公司的申請單，但不能簽核、
  // 不能改後台設定。
  canViewAllReports Boolean @default(false)

  applications   ExpenseApplication[] @relation("Applicant")
  approvalRecords ApprovalRecord[]
  uploadedAttachments Attachment[]
  notifications  Notification[]

  createdAt DateTime @default(now())

  @@unique([companyId, email])
  @@index([companyId, role])
}

// ── 申請單 ────────────────────────────────────────
model ExpenseApplication {
  id              String          @id @default(cuid())
  companyId       String
  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  applicantId     String
  applicant       User            @relation("Applicant", fields: [applicantId], references: [id])
  // 部門/費用性質/申請日期在「草稿」狀態下可以是空的(使用者可能只是先開一張單、
  // 部門都還沒選就存了)，所以放寬成可為 null；真正送出(status 從 draft 轉成 pending)
  // 時才要求這幾個欄位一定要有值，那道檢查在 routes/applications.ts 的 submit-draft
  // 路由做，不是靠資料庫層級的 NOT NULL 擋。
  departmentId    String?
  department      Department?     @relation(fields: [departmentId], references: [id])
  expenseNatureId String?
  expenseNature   ExpenseNature?  @relation(fields: [expenseNatureId], references: [id])

  applicationDate DateTime?
  purpose         String?

  // optionalFields 開啟時才會用到，未開啟則為 null
  payeeName            String?
  payeeBankInfo        Json?
  requestedPaymentDate DateTime?

  totalAmountTWD Decimal @default(0) @db.Decimal(12, 2)
  status         String  @default("pending") // draft / pending / approved / rejected / returned

  // 申請人送出時的電子簽名(手寫或上傳)，存 base64 data URL。
  applicantSignature String? @db.Text

  // 簽核關卡退回時的備註說明——退回是獨立於駁回的動作，退回後申請人可以修改內容重新送出，
  // 重新跑一次完整簽核流程；這裡只留「最近一次」退回的原因給申請人/簽核者參考，
  // 不做完整多輪退回的歷史留存(避免把 schema 複雜化)。
  returnComment        String?   @db.Text
  returnedAt           DateTime?
  returnedByStageLabel String?

  items           ExpenseItem[]
  approvalRecords ApprovalRecord[]
  attachments     Attachment[]
  notifications   Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, status])
  @@index([applicantId])
}

model Attachment {
  id            String             @id @default(cuid())
  applicationId String
  application   ExpenseApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  // 憑證檔案存在伺服器磁碟(server/uploads/)，不進 DB 也不進 git——手機拍照動輒好幾 MB，
  // 一張申請單可能有好幾張憑證，塞 base64 進 Postgres 會讓資料庫肥大、備份變慢。
  // filename 是原始檔名(顯示用)，storedName 是實際存在磁碟上的檔名(用 cuid 產生，
  // 避免撞名或路徑穿越攻擊，跟使用者上傳的原始檔名脫鉤)。
  filename   String
  storedName String
  mimeType   String
  size       Int

  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id])

  createdAt DateTime @default(now())

  @@index([applicationId])
}

model ExpenseItem {
  id            String          @id @default(cuid())
  applicationId String
  application   ExpenseApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  categoryId    String
  category      ExpenseCategory @relation(fields: [categoryId], references: [id])

  description String?
  date        DateTime?

  // optionalFields.projectCode / invoiceDate 開啟時才會用到
  projectCode String?
  invoiceDate DateTime?

  currency     String  @default("TWD") // multiCurrencyEnabled 時才會有 TWD 以外的值
  amount       Decimal @db.Decimal(12, 2)
  amountInTWD  Decimal @db.Decimal(12, 2)

  @@index([applicationId])
}

// ── 簽核紀錄 ──────────────────────────────────────
model ApprovalRecord {
  id            String         @id @default(cuid())
  applicationId String
  application   ExpenseApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  stageId       String
  stage         ApprovalStage  @relation(fields: [stageId], references: [id])
  approverId    String?
  approver      User?          @relation(fields: [approverId], references: [id])

  status    String    @default("waiting") // waiting / approved / rejected
  comment   String?
  signedAt  DateTime?
  // 簽核人核准/駁回當下的電子簽名(手寫或上傳)，存 base64 data URL。
  signatureImage String? @db.Text

  @@unique([applicationId, stageId])
  @@index([applicationId])
}

// ── 通知 ──────────────────────────────────────────
// 站內通知(鈴鐺清單)跟 email 共用同一個觸發點：申請單送出、待簽核、核准/駁回/退回——
// 站內這份留存歷史紀錄(未讀/已讀)，email 是額外的即時提醒，兩者各自獨立，
// 其中一個失敗(例如 SMTP 沒設定)不影響另一個。applicationId 允許為 null 是為了保留彈性，
// 目前所有通知都一定會帶著它，之後若有跟特定申請單無關的系統通知也能沿用同一張表。
model Notification {
  id            String              @id @default(cuid())
  companyId     String
  company       Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId        String
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicationId String?
  application   ExpenseApplication? @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  // submitted(有新申請單待你簽核) / approved(申請已核准) / rejected(已駁回) / returned(已退回)
  type    String
  title   String
  message String

  read Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([companyId, userId, read])
}
